{
  "name": "okf-knowledge-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "node ./scripts/run-vitest-app.mjs run --config vitest.app.config.ts",
    "storybook": "storybook dev -p 6006",
    "test:storybook": "vitest --project storybook",
    "build-storybook": "storybook build",
    "test:storybook:smoke": "pnpm build-storybook && node ./scripts/smoke-built-storybook.mjs",
    "test:visual": "playwright test tests/visual/markdown-viewer.spec.ts",
    "dev:setup:macos": "bash scripts/setup-macos-dev-signing.sh",
    "tauri": "bash scripts/tauri-with-macos-signing.sh"
  },
  "dependencies": {
    "@mdxeditor/editor": "^4.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.2.14",
    "@tauri-apps/api": "2",
    "@tauri-apps/plugin-clipboard-manager": "~2",
    "@tauri-apps/plugin-dialog": "~2",
    "@tauri-apps/plugin-opener": "~2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.26.0",
    "mermaid": "^11",
    "pretendard": "1",
    "react": "19",
    "react-dom": "19",
    "react-markdown": "^10",
    "react-router-dom": "7",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6",
    "remark-gfm": "^4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/vite": "4",
    "@tauri-apps/cli": "2",
    "@testing-library/jest-dom": "6",
    "@testing-library/react": "16",
    "@testing-library/user-event": "14",
    "@types/node": "22",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@vitejs/plugin-react": "5",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "axe-core": "4",
    "jsdom": "27",
    "playwright": "^1.62.1",
    "storybook": "^10.5.10",
    "tailwindcss": "4",
    "typescript": "5",
    "vite": "7",
    "vitest": "^4.1.11"
  }
}
