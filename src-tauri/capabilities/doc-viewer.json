{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "doc-viewer",
  "description": "Least-privilege capability for standalone OkHub document viewer windows (app #[tauri::command] IPC is allowed for local windows when has_app_acl is false in build.rs; excludes dialog/opener-path)",
  "windows": [
    "doc-viewer-*"
  ],
  "permissions": [
    "core:default",
    "clipboard-manager:allow-write-text",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/login/device"
        },
        {
          "url": "https://github.com/settings/installations"
        },
        {
          "url": "https://github.com/Mockly-Company/okf-knowledge-hub/releases"
        }
      ]
    }
  ]
}
