{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop capability for OkHub",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "clipboard-manager:allow-write-text",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/login/device"
        },
        {
          "url": "https://github.com/settings/installations"
        },
        {
          "url": "https://github.com/Mockly-Company/okf-knowledge-hub/releases"
        },
        {
          "url": "https://github.com/*/*/pull/*"
        },
        {
          "url": "https://github.com/*/*/issues/*"
        },
        {
          "url": "https://github.com/orgs/*/projects/*"
        },
        {
          "url": "https://github.com/users/*/projects/*"
        },
        {
          "url": "https://www.figma.com/design/*"
        },
        {
          "url": "https://www.figma.com/file/*"
        },
        {
          "url": "https://www.figma.com/proto/*"
        },
        {
          "url": "https://www.figma.com/board/*"
        },
        {
          "url": "https://figma.com/design/*"
        },
        {
          "url": "https://figma.com/file/*"
        },
        {
          "url": "https://docs.google.com/document/*"
        },
        {
          "url": "https://docs.google.com/spreadsheets/*"
        },
        {
          "url": "https://docs.google.com/presentation/*"
        },
        {
          "url": "https://miro.com/app/board/*"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "**/.okf/workspace.yml"
        }
      ]
    }
  ]
}
